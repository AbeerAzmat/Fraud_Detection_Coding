# Online Payment Fraud Detection Analysis

## 1. Load Data and Explore

```python
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load dataset
data = pd.read_csv('data/new_data.csv')
print(data.head())
print(data.info())
print(data.describe())

# Data types counts
print("Categorical variables:", sum(data.dtypes == 'object'))
print("Integer variables:", sum(data.dtypes == 'int64'))
print("Float variables:", sum(data.dtypes == 'float64'))

# Visualizations
sns.countplot(x='type', data=data)
plt.title('Payment Type Counts')
plt.show()

sns.barplot(x='type', y='amount', data=data)
plt.title('Payment Type vs Amount')
plt.show()

sns.distplot(data['step'], bins=50)
plt.title('Step Distribution')
plt.show()

sns.heatmap(data.corr(), cmap='BrBG', annot=True, fmt='.2f', linewidths=2)
plt.title('Correlation Heatmap')
plt.show()


## 2. Data Processing and Feature Engineering

type_dummies = pd.get_dummies(data['type'], drop_first=True)
data_new = pd.concat([data, type_dummies], axis=1)

X = data_new.drop(['isFraud', 'type', 'nameOrig', 'nameDest'], axis=1)
y = data_new['isFraud']

print(X.shape, y.shape)


## 3. Train-Test Split

from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42)


## 4. Model Training and Evaluation

from xgboost import XGBClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import roc_auc_score, plot_confusion_matrix
import matplotlib.pyplot as plt

models = [
    LogisticRegression(max_iter=1000),
    XGBClassifier(use_label_encoder=False, eval_metric='logloss'),
    SVC(kernel='rbf', probability=True),
    RandomForestClassifier(n_estimators=7, criterion='entropy', random_state=7)
]

for model in models:
    model.fit(X_train, y_train)
    train_preds = model.predict_proba(X_train)[:, 1]
    val_preds = model.predict_proba(X_test)[:, 1]
    
    print(f'{model.__class__.__name__}:')
    print('Training ROC AUC:', roc_auc_score(y_train, train_preds))
    print('Validation ROC AUC:', roc_auc_score(y_test, val_preds))
    print()
    
# Plot confusion matrix for best model (example: XGBClassifier)
plot_confusion_matrix(models[1], X_test, y_test)
plt.title('Confusion Matrix - XGBClassifier')
plt.show()
